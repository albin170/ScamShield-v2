# ScamShield Backend Environment Variables
# Copy this file to .env and fill in real values before running.

# ── Security ──────────────────────────────────────────────────────────────
# REQUIRED: Random secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-with-python-secrets-token_hex-32

# ── Super Admin Bootstrap ─────────────────────────────────────────────────
# Set this ONCE to bootstrap the super admin account.
# After first run, the account is stored with a bcrypt hash.
# This env var is only used if the superadmin account doesn't exist yet.
# Username defaults to "albin" if SUPERADMIN_USERNAME is not set.
SUPERADMIN_USERNAME=albin
SUPERADMIN_INITIAL_PASSWORD=evengely

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ── Upload Limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25

# ── Server ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Token Expiry ──────────────────────────────────────────────────────────
TOKEN_EXPIRE_MINUTES=480
